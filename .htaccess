RewriteEngine On

# http → https, ecolever.co.kr → www.ecolever.co.kr
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.ecolever.co.kr%{REQUEST_URI} [L,R=301]

# 임시(2026-11-25): 가비아가 새 파일 생성을 막아 guide/faq.html이 아직 없음 → 홈 FAQ로. 풀리면 /guide/faq.html 301로 되돌림
RewriteRule ^faq/?$ https://www.ecolever.co.kr/#faq [L,R=302,NE]
RewriteRule ^guide/faq\.html$ https://www.ecolever.co.kr/#faq [L,R=302,NE]

# 압축 · 캐시 (페이지 속도 = 검색 순위·전환율)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
